#!/bin/bash
set -euxo pipefail

PRETTIER_VERSION="3.8.5"

if [[ "${1:-}" == "--write" ]]; then
    MODE="--write"
else
    MODE="--check"
fi

pnpm dlx "prettier@${PRETTIER_VERSION}" $MODE *.md docs || {
    echo "To fix, run from the root of the repo:"
    echo "  pnpm dlx prettier@${PRETTIER_VERSION} --write *.md docs"
    false
}
